{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamboard.games/schemas/reducer-runtime.schema.json",
  "title": "ReducerRuntimeContract",
  "description": "Wire-format contract between the JS reducer bundle and the SDK-owned reducer bundle ABI. Authored by hand; consumed by TypeScript codegen. Any change here is a breaking protocol change and must bump REDUCER_CONTRACT_VERSION.",
  "type": "object",
  "properties": {
    "version": { "$ref": "#/$defs/ReducerContractVersion" }
  },
  "required": ["version"],
  "additionalProperties": false,

  "$defs": {
    "ReducerContractVersion": {
      "description": "Semver-style major.minor.patch string. Hosts require an exact match with REDUCER_CONTRACT_VERSION; mixed contract versions are not supported.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },

    "EffectId": {
      "description": "Locally-unique id scoped to a single accept payload. The SDK mints these; the host uses them as keys into the continuations map.",
      "type": "string",
      "minLength": 1
    },

    "ContinuationToken": {
      "description": "Opaque handle the host passes back to the bundle when the effect resolves.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "data": { "$ref": "#/$defs/JsonValue" }
      },
      "required": ["id", "data"],
      "additionalProperties": false
    },

    "ContinuationMap": {
      "description": "Sparse map keyed by EffectId. Presence = effect has a continuation; absence = fire-and-forget.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/ContinuationToken" }
    },

    "JsonValue": {
      "description": "Any JSON-compatible value. Deliberately permissive; callers enforce payload shapes elsewhere.",
      "anyOf": [
        { "type": "object" },
        { "type": "array" },
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },

    "ReducerSetupSelection": {
      "description": "Resolved setup profile and option values selected for this reducer session.",
      "type": "object",
      "properties": {
        "profileId": { "type": "string", "minLength": 1 },
        "optionValues": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [{ "type": "string" }, { "type": "null" }]
          }
        }
      },
      "required": ["profileId", "optionValues"],
      "additionalProperties": false
    },

    "RngOperationParameter": {
      "description": "One public, non-secret parameter that identifies the deterministic RNG operation without revealing its sampled value.",
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" }
      ]
    },

    "RngOperation": {
      "description": "Structured identity for a deterministic RNG operation. Sampled values are deliberately excluded.",
      "type": "object",
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/RngOperationParameter"
          }
        }
      },
      "required": ["kind", "parameters"],
      "additionalProperties": false
    },

    "RngDraw": {
      "description": "Persisted metadata for one deterministic RNG cursor advance. The sampled value is never persisted in this structured projection.",
      "type": "object",
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "cursorBefore": { "type": "integer", "minimum": 0 },
        "cursorAfter": { "type": "integer", "minimum": 0 },
        "operation": { "$ref": "#/$defs/RngOperation" }
      },
      "required": ["index", "cursorBefore", "cursorAfter", "operation"],
      "additionalProperties": false
    },

    "RngState": {
      "description": "Deterministic RNG cursor state owned by the reducer runtime. `trace` remains as a legacy compatibility field; new diagnostics consume structured `draws`.",
      "type": "object",
      "properties": {
        "seed": {
          "anyOf": [
            { "type": "integer", "format": "int64" },
            { "type": "null" }
          ]
        },
        "cursor": { "type": "integer" },
        "trace": {
          "type": "array",
          "items": { "type": "string" }
        },
        "draws": {
          "description": "Structured draw metadata added in reducer contract 0.4. Older persisted states may omit it and are normalized by the SDK ingress codec.",
          "type": "array",
          "items": { "$ref": "#/$defs/RngDraw" }
        }
      },
      "required": ["seed", "cursor", "trace"],
      "additionalProperties": false
    },

    "ReducerFlowState": {
      "description": "Current reducer phase and actor bookkeeping.",
      "type": "object",
      "properties": {
        "currentPhase": { "type": "string", "minLength": 1 },
        "turn": { "type": "integer" },
        "round": { "type": "integer" },
        "activePlayers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["currentPhase", "turn", "round", "activePlayers"],
      "additionalProperties": false
    },

    "RuntimeSimultaneousSubmission": {
      "description": "A sealed simultaneous-phase submission captured before all actors have submitted.",
      "type": "object",
      "properties": {
        "interactionId": { "type": "string", "minLength": 1 },
        "params": { "$ref": "#/$defs/JsonValue" }
      },
      "required": ["interactionId", "params"],
      "additionalProperties": false
    },

    "RuntimeSimultaneousCurrent": {
      "description": "In-progress simultaneous phase submission bucket.",
      "type": "object",
      "properties": {
        "phaseName": { "type": "string", "minLength": 1 },
        "actors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "submissions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/RuntimeSimultaneousSubmission"
          }
        }
      },
      "required": ["phaseName", "actors", "submissions"],
      "additionalProperties": false
    },

    "RuntimeSimultaneousState": {
      "description": "Runtime storage for simultaneous-player phases. `current: null` means no simultaneous submission is pending.",
      "type": "object",
      "properties": {
        "current": {
          "anyOf": [
            { "$ref": "#/$defs/RuntimeSimultaneousCurrent" },
            { "type": "null" }
          ]
        }
      },
      "required": ["current"],
      "additionalProperties": false
    },

    "TransitionRecord": {
      "description": "Last phase transition applied by the reducer runtime.",
      "type": "object",
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 }
      },
      "required": ["from", "to"],
      "additionalProperties": false
    },

    "ReducerRuntimeState": {
      "description": "Cross-runtime reducer bookkeeping that must round-trip through hosts unchanged.",
      "type": "object",
      "properties": {
        "rng": { "$ref": "#/$defs/RngState" },
        "setup": {
          "anyOf": [
            { "$ref": "#/$defs/ReducerSetupSelection" },
            { "type": "null" }
          ]
        },
        "simultaneous": { "$ref": "#/$defs/RuntimeSimultaneousState" },
        "lastTransition": {
          "anyOf": [{ "$ref": "#/$defs/TransitionRecord" }, { "type": "null" }]
        }
      },
      "required": ["rng", "setup", "simultaneous", "lastTransition"],
      "additionalProperties": false
    },

    "ReducerDomainState": {
      "description": "Reducer domain state envelope. Game-authored payloads remain JSON-erased here and are validated by the app SDK against the manifest and phase schemas.",
      "type": "object",
      "properties": {
        "table": { "$ref": "#/$defs/JsonValue" },
        "publicState": { "$ref": "#/$defs/JsonValue" },
        "privateState": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/JsonValue" }
        },
        "hiddenState": { "$ref": "#/$defs/JsonValue" },
        "flow": { "$ref": "#/$defs/ReducerFlowState" },
        "phase": { "$ref": "#/$defs/JsonValue" }
      },
      "required": [
        "table",
        "publicState",
        "privateState",
        "hiddenState",
        "flow",
        "phase"
      ],
      "additionalProperties": false
    },

    "ReducerSessionMeta": {
      "description": "Optional SDK-owned metadata for stale-artifact detection. Hosts may persist and echo this object without interpreting it.",
      "type": "object",
      "properties": {
        "contractFingerprint": {
          "description": "Versioned SDK contract fingerprint for the manifest and decoded state shape that produced this session.",
          "type": "string",
          "pattern": "^cfp[0-9]+:[a-f0-9]{16}$"
        }
      },
      "required": ["contractFingerprint"],
      "additionalProperties": false
    },

    "ReducerSessionState": {
      "description": "Canonical session snapshot exchanged across the JS reducer bundle, host runtime, and persistence boundary.",
      "type": "object",
      "properties": {
        "meta": { "$ref": "#/$defs/ReducerSessionMeta" },
        "domain": { "$ref": "#/$defs/ReducerDomainState" },
        "runtime": { "$ref": "#/$defs/ReducerRuntimeState" }
      },
      "required": ["domain", "runtime"],
      "additionalProperties": false
    },

    "GameInput": {
      "description": "Input submitted by a player. Tagged union; kind is the discriminator. Currently a single variant (interaction) so the union is trivially closed, but kept as oneOf so future input shapes (system events, etc.) can be added without breaking the code path.",
      "oneOf": [{ "$ref": "#/$defs/GameInputInteraction" }]
    },

    "GameInputInteraction": {
      "description": "A player submitting an interaction. An interaction is the unified authoring primitive for every player-originated input, identified by interactionId, with params carrying any collector-specific payload (e.g., prompt selection, board target, form fields).",
      "type": "object",
      "properties": {
        "kind": { "const": "interaction" },
        "playerId": { "type": "string", "minLength": 1 },
        "interactionId": { "type": "string", "minLength": 1 },
        "params": { "$ref": "#/$defs/JsonValue" }
      },
      "required": ["kind", "playerId", "interactionId", "params"],
      "additionalProperties": false
    },

    "Effect": {
      "description": "A thing the host should do. Every variant has effectId + type and carries NO continuation field. Continuations are expressed via the sibling ContinuationMap keyed by effectId.",
      "oneOf": [
        { "$ref": "#/$defs/EffectTransition" },
        { "$ref": "#/$defs/EffectRollDie" },
        { "$ref": "#/$defs/EffectShuffleSharedZone" },
        { "$ref": "#/$defs/EffectShufflePlayerZone" }
      ]
    },

    "EffectTransition": {
      "type": "object",
      "properties": {
        "effectId": { "$ref": "#/$defs/EffectId" },
        "type": { "const": "transition" },
        "to": { "type": "string", "minLength": 1 }
      },
      "required": ["effectId", "type", "to"],
      "additionalProperties": false
    },

    "EffectRollDie": {
      "type": "object",
      "properties": {
        "effectId": { "$ref": "#/$defs/EffectId" },
        "type": { "const": "rollDie" },
        "dieId": { "type": "string", "minLength": 1 }
      },
      "required": ["effectId", "type", "dieId"],
      "additionalProperties": false
    },

    "EffectShuffleSharedZone": {
      "type": "object",
      "properties": {
        "effectId": { "$ref": "#/$defs/EffectId" },
        "type": { "const": "shuffleSharedZone" },
        "zoneId": { "type": "string", "minLength": 1 }
      },
      "required": ["effectId", "type", "zoneId"],
      "additionalProperties": false
    },

    "EffectShufflePlayerZone": {
      "type": "object",
      "properties": {
        "effectId": { "$ref": "#/$defs/EffectId" },
        "type": { "const": "shufflePlayerZone" },
        "zoneId": { "type": "string", "minLength": 1 },
        "playerId": { "type": "string", "minLength": 1 }
      },
      "required": ["effectId", "type", "zoneId", "playerId"],
      "additionalProperties": false
    },

    "ReducerInputValidationResult": {
      "type": "object",
      "properties": {
        "valid": { "type": "boolean" },
        "errorCode": { "type": "string" },
        "message": { "type": "string" }
      },
      "required": ["valid"],
      "additionalProperties": false
    },

    "InitializeRequest": {
      "description": "Arguments passed to `createReducerBundle(...).initialize(...)`. `table` is intentionally erased at this contract layer; the authored bundle validates it against its manifest-derived schema.",
      "type": "object",
      "properties": {
        "table": { "$ref": "#/$defs/JsonValue" },
        "playerIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "rngSeed": {
          "anyOf": [
            { "type": "integer", "format": "int64" },
            { "type": "null" }
          ]
        },
        "setup": {
          "anyOf": [
            { "$ref": "#/$defs/ReducerSetupSelection" },
            { "type": "null" }
          ]
        }
      },
      "required": ["table", "playerIds"],
      "additionalProperties": false
    },

    "InitializePhaseRequest": {
      "description": "Arguments passed to `createReducerBundle(...).initializePhase(...)`.",
      "type": "object",
      "properties": {
        "state": { "$ref": "#/$defs/ReducerSessionState" },
        "to": { "type": "string", "minLength": 1 }
      },
      "required": ["state", "to"],
      "additionalProperties": false
    },

    "ValidateInputRequest": {
      "description": "Arguments passed to `createReducerBundle(...).validateInput(...)`.",
      "type": "object",
      "properties": {
        "state": { "$ref": "#/$defs/ReducerSessionState" },
        "input": { "$ref": "#/$defs/GameInput" }
      },
      "required": ["state", "input"],
      "additionalProperties": false
    },

    "ReduceRequest": {
      "description": "Arguments passed to `createReducerBundle(...).reduce(...)`.",
      "type": "object",
      "properties": {
        "state": { "$ref": "#/$defs/ReducerSessionState" },
        "input": { "$ref": "#/$defs/GameInput" }
      },
      "required": ["state", "input"],
      "additionalProperties": false
    },

    "DispatchRequest": {
      "description": "Arguments passed to `createReducerBundle(...).dispatch(...)`.",
      "type": "object",
      "properties": {
        "state": { "$ref": "#/$defs/ReducerSessionState" },
        "input": { "$ref": "#/$defs/GameInput" }
      },
      "required": ["state", "input"],
      "additionalProperties": false
    },

    "ReduceResult": {
      "description": "Pure reduce output (no host side-effects yet). Discriminator is `kind`.",
      "oneOf": [
        { "$ref": "#/$defs/ReduceResultReject" },
        { "$ref": "#/$defs/ReduceResultAccept" }
      ]
    },

    "ReduceResultReject": {
      "type": "object",
      "properties": {
        "kind": { "const": "reject" },
        "errorCode": { "type": "string", "minLength": 1 },
        "message": { "type": "string" }
      },
      "required": ["kind", "errorCode"],
      "additionalProperties": false
    },

    "ReduceResultAccept": {
      "type": "object",
      "properties": {
        "kind": { "const": "accept" },
        "state": { "$ref": "#/$defs/ReducerSessionState" },
        "terminal": { "$ref": "#/$defs/GameOutcome" },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/Effect" }
        },
        "continuations": { "$ref": "#/$defs/ContinuationMap" },
        "events": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/GameEvent" }
        }
      },
      "required": ["kind", "state", "effects", "continuations", "events"],
      "additionalProperties": false
    },

    "DispatchTrace": {
      "description": "Per-step trace emitted by the host as it applies effects. Parallel in shape to ReducerRuntimeLogEntry but without the version field.",
      "oneOf": [
        { "$ref": "#/$defs/DispatchTraceAcceptedClientInput" },
        { "$ref": "#/$defs/DispatchTraceAppliedEffect" },
        { "$ref": "#/$defs/DispatchTraceRngConsumption" }
      ]
    },

    "DispatchTraceAcceptedClientInput": {
      "type": "object",
      "properties": {
        "kind": { "const": "acceptedClientInput" },
        "input": { "$ref": "#/$defs/GameInput" }
      },
      "required": ["kind", "input"],
      "additionalProperties": false
    },

    "DispatchTraceAppliedEffect": {
      "description": "Applied effect trace. The continuation is inlined here so each trace entry is self-contained; the host emits the token it pulled from the sibling ContinuationMap at accept time.",
      "type": "object",
      "properties": {
        "kind": { "const": "appliedEffect" },
        "effect": { "$ref": "#/$defs/Effect" },
        "continuation": { "$ref": "#/$defs/ContinuationToken" }
      },
      "required": ["kind", "effect"],
      "additionalProperties": false
    },

    "DispatchTraceRngConsumption": {
      "type": "object",
      "properties": {
        "kind": { "const": "rngConsumption" },
        "version": { "const": 2 },
        "operation": { "type": "string", "minLength": 1 },
        "drawIndex": { "type": "integer", "minimum": 0 },
        "traceEntry": { "type": "string" }
      },
      "required": ["kind", "version", "operation", "drawIndex", "traceEntry"],
      "additionalProperties": false
    },

    "DispatchResult": {
      "description": "Result of dispatching a pure reduce result (i.e., applying effects).",
      "oneOf": [
        { "$ref": "#/$defs/DispatchResultReject" },
        { "$ref": "#/$defs/DispatchResultAccept" }
      ]
    },

    "DispatchResultReject": {
      "type": "object",
      "properties": {
        "kind": { "const": "reject" },
        "errorCode": { "type": "string", "minLength": 1 },
        "message": { "type": "string" }
      },
      "required": ["kind", "errorCode"],
      "additionalProperties": false
    },

    "DispatchResultAccept": {
      "type": "object",
      "properties": {
        "kind": { "const": "accept" },
        "state": { "$ref": "#/$defs/ReducerSessionState" },
        "terminal": { "$ref": "#/$defs/GameOutcome" },
        "trace": {
          "type": "array",
          "items": { "$ref": "#/$defs/DispatchTrace" }
        },
        "events": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/GameEvent" }
        }
      },
      "required": ["kind", "state", "trace", "events"],
      "additionalProperties": false
    },

    "GameEventDetail": {
      "description": "One bounded public detail in a reducer-authored game event.",
      "type": "object",
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "value": {
          "anyOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" }
          ]
        }
      },
      "required": ["label", "value"],
      "additionalProperties": false
    },

    "SystemActionEvent": {
      "description": "Inspectable public event emitted by a deterministic reducer-owned procedure.",
      "type": "object",
      "properties": {
        "kind": { "const": "systemAction" },
        "procedureId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "details": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/GameEventDetail" }
        }
      },
      "required": ["kind", "procedureId", "title"],
      "additionalProperties": false
    },

    "GameEvent": {
      "description": "Bounded reducer-authored public game event.",
      "oneOf": [{ "$ref": "#/$defs/SystemActionEvent" }]
    },

    "OutcomeResult": {
      "description": "Reducer-declared player result in a terminal outcome.",
      "type": "string",
      "enum": ["win", "draw", "loss", "eliminated"]
    },

    "OutcomeScoreComponent": {
      "description": "One numeric score contribution in an authoritative standing.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        }
      },
      "required": ["id", "label", "value"],
      "additionalProperties": false
    },

    "OutcomeTieBreak": {
      "description": "One deterministic tie-break value used by an authoritative standing.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "anyOf": [{ "type": "number" }, { "type": "string" }]
        }
      },
      "required": ["id", "label", "value"],
      "additionalProperties": false
    },

    "OutcomeStanding": {
      "description": "Authoritative terminal standing for exactly one player.",
      "type": "object",
      "properties": {
        "playerId": { "type": "string", "minLength": 1 },
        "rank": { "type": "integer", "minimum": 1 },
        "result": { "$ref": "#/$defs/OutcomeResult" },
        "score": { "type": "number" },
        "scoreBreakdown": {
          "type": "array",
          "items": { "$ref": "#/$defs/OutcomeScoreComponent" }
        },
        "tieBreaks": {
          "type": "array",
          "items": { "$ref": "#/$defs/OutcomeTieBreak" }
        }
      },
      "required": ["playerId", "rank", "result"],
      "additionalProperties": false
    },

    "GameOutcomeReason": {
      "description": "Stable reducer-declared reason for game termination.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "required": ["code"],
      "additionalProperties": false
    },

    "GameOutcome": {
      "description": "Reducer-declared authoritative game-end outcome. Absence means the transition is non-terminal.",
      "type": "object",
      "properties": {
        "reason": { "$ref": "#/$defs/GameOutcomeReason" },
        "standings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/OutcomeStanding" }
        }
      },
      "required": ["reason", "standings"],
      "additionalProperties": false
    },

    "ReducerRuntimeLogEntry": {
      "description": "Persisted reducer runtime log entry. Parallel to dispatch trace, with a committed version and state snapshots for recovery.",
      "oneOf": [
        { "$ref": "#/$defs/ReducerRuntimeLogEntryAcceptedClientInput" },
        { "$ref": "#/$defs/ReducerRuntimeLogEntryAppliedEffect" },
        { "$ref": "#/$defs/ReducerRuntimeLogEntryRngConsumption" },
        { "$ref": "#/$defs/ReducerRuntimeLogEntryStateCommit" }
      ]
    },

    "ReducerRuntimeLogEntryAcceptedClientInput": {
      "type": "object",
      "properties": {
        "kind": { "const": "acceptedClientInput" },
        "version": { "type": "integer" },
        "input": { "$ref": "#/$defs/GameInput" }
      },
      "required": ["kind", "version", "input"],
      "additionalProperties": false
    },

    "ReducerRuntimeLogEntryAppliedEffect": {
      "type": "object",
      "properties": {
        "kind": { "const": "appliedEffect" },
        "version": { "type": "integer" },
        "effect": { "$ref": "#/$defs/Effect" },
        "continuation": {
          "anyOf": [{ "$ref": "#/$defs/ContinuationToken" }, { "type": "null" }]
        }
      },
      "required": ["kind", "version", "effect", "continuation"],
      "additionalProperties": false
    },

    "ReducerRuntimeLogEntryRngConsumption": {
      "type": "object",
      "properties": {
        "kind": { "const": "rngConsumption" },
        "version": { "type": "integer" },
        "operation": { "type": "string", "minLength": 1 },
        "drawIndex": {
          "description": "Index into runtime.rng.draws for contract 0.4+ entries. Older persisted log entries omit it.",
          "type": "integer",
          "minimum": 0
        },
        "traceEntry": { "type": "string" }
      },
      "required": ["kind", "version", "operation", "traceEntry"],
      "additionalProperties": false
    },

    "ReducerRuntimeLogEntryStateCommit": {
      "type": "object",
      "properties": {
        "kind": { "const": "stateCommit" },
        "version": { "type": "integer" },
        "state": { "$ref": "#/$defs/ReducerSessionState" }
      },
      "required": ["kind", "version", "state"],
      "additionalProperties": false
    },

    "SeatProjection": {
      "description": "One seat's slice of `projectSeatsDynamic(...)`. `availableInteractionRefs` and `zones` stay JSON-erased here because their concrete shapes are owned by the gameplay payload/OpenAPI contracts, not reducer-contract.",
      "type": "object",
      "properties": {
        "view": { "$ref": "#/$defs/JsonValue" },
        "availableInteractionRefs": { "$ref": "#/$defs/JsonValue" },
        "zones": { "$ref": "#/$defs/JsonValue" }
      },
      "additionalProperties": false
    },

    "SimultaneousPhaseProjection": {
      "description": "Visibility-safe progress metadata for an active simultaneous-player phase. Submission params stay hidden in runtime state; projection exposes only which actors have sealed or are still pending.",
      "type": "object",
      "properties": {
        "phaseName": { "type": "string", "minLength": 1 },
        "interactionId": { "type": "string", "minLength": 1 },
        "actorIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "sealedPlayerIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "pendingPlayerIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": [
        "phaseName",
        "interactionId",
        "actorIds",
        "sealedPlayerIds",
        "pendingPlayerIds"
      ],
      "additionalProperties": false
    },

    "SchedulerContinuationDependency": {
      "description": "One scheduler-proven causal wait. Values contain public actor identities only; submitted params and private domain facts never cross this boundary.",
      "type": "object",
      "properties": {
        "waiterPlayerId": { "type": "string", "minLength": 1 },
        "blockerPlayerIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["waiterPlayerId", "blockerPlayerIds"],
      "additionalProperties": false
    },

    "SchedulerFlowAuthorityProjection": {
      "description": "Versioned, visibility-safe scheduler authority for inspect/dev parity. It exposes only public actor identities and causal relationships derived by trusted phase and interaction authorization machinery.",
      "type": "object",
      "properties": {
        "version": { "const": 1 },
        "activePlayerIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "pendingPlayerIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "continuationDependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/SchedulerContinuationDependency" }
        }
      },
      "required": [
        "version",
        "activePlayerIds",
        "pendingPlayerIds",
        "continuationDependencies"
      ],
      "additionalProperties": false
    },

    "SeatProjectionBundle": {
      "description": "Result of `createReducerBundle(...).projectSeatsDynamic(...)`.",
      "type": "object",
      "properties": {
        "currentStage": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "stageSeats": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "simultaneousPhase": {
          "anyOf": [
            { "$ref": "#/$defs/SimultaneousPhaseProjection" },
            { "type": "null" }
          ]
        },
        "schedulerFlow": {
          "$ref": "#/$defs/SchedulerFlowAuthorityProjection"
        },
        "sharedView": { "$ref": "#/$defs/JsonValue" },
        "interactionsByRef": { "$ref": "#/$defs/JsonValue" },
        "seats": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/SeatProjection" }
        },
        "timing": {
          "$ref": "#/$defs/ProjectionTimingMetadata"
        }
      },
      "required": ["seats"],
      "additionalProperties": false
    },

    "ProjectionTimingMetadata": {
      "description": "Optional SDK-owned diagnostics for projectSeatsDynamic internals. Hosts may record these values for profiling; reducer authors should not depend on them.",
      "type": "object",
      "properties": {
        "resolveAvailableInteractionsMs": { "type": "number", "minimum": 0 },
        "resolveViewMs": { "type": "number", "minimum": 0 },
        "resolveZoneHandlesMs": { "type": "number", "minimum": 0 },
        "descriptorHashMs": { "type": "number", "minimum": 0 }
      },
      "required": [
        "resolveAvailableInteractionsMs",
        "resolveViewMs",
        "resolveZoneHandlesMs",
        "descriptorHashMs"
      ],
      "additionalProperties": false
    },

    "ProjectSeatsDynamicRequest": {
      "description": "Arguments passed to `createReducerBundle(...).projectSeatsDynamic(...)`.",
      "type": "object",
      "properties": {
        "state": { "$ref": "#/$defs/ReducerSessionState" },
        "playerIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "projectionMode": {
          "anyOf": [
            { "type": "string", "enum": ["full", "actionsOnly"] },
            { "type": "null" }
          ]
        }
      },
      "required": ["state", "playerIds"],
      "additionalProperties": false
    },

    "BoardStaticProjection": {
      "description": "Session-scoped projection produced by `projectStatic`. Computed once per reducer session from the manifest + setup profile (no mutable state), cached on the host, and merged back into each seat view on the client. `hash` identifies the payload so clients and the host can detect accidental drift. `manifestVersion` identifies the bundle build so a restart with a new bundle invalidates the cache. Per-seat dynamic projection (view, availableInteractionRefs, zones) continues to flow through `projectSeatsDynamic` and is decoded into typed `InteractionDescriptor` / `ZoneHandles` shapes defined by the OpenAPI game-messages schema, so it is not modeled here.",
      "type": "object",
      "properties": {
        "view": { "$ref": "#/$defs/JsonValue" },
        "hash": { "type": "string", "minLength": 1 },
        "manifestVersion": { "type": "string" }
      },
      "required": ["view", "hash", "manifestVersion"],
      "additionalProperties": false
    }
  }
}
