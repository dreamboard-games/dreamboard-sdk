    "BoardStaticProjection": {
      "description": "Session-scoped projection produced by `projectStatic`. Computed once per reducer session from the manifest + setup profile (no mutable state), cached on the Kotlin host, and merged back into each seat view on the client. `hash` identifies the payload so clients and the host can detect accidental drift. `manifestVersion` identifies the bundle build so a restart with a new bundle invalidates the cache. Per-seat dynamic projection (view, availableInteractionRefs, zones) continues to flow through `projectSeatsDynamic` and is decoded into typed `InteractionDescriptor` / `ZoneHandles` shapes defined by the OpenAPI game-messages schema, so it is not modeled here.",
      "type": "object",
      "properties": {
        "view": { "$ref": "#/$defs/JsonValue" },
        "hash": { "type": "string", "minLength": 1 },
        "manifestVersion": { "type": "string" }
      },
      "required": ["view", "hash", "manifestVersion"],
      "additionalProperties": false
    }
