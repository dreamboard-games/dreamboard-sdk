{
  "name": "@dreamboard-games/reducer-contract",
  "version": "0.2.0",
  "private": true,
  "description": "Single-source-of-truth TypeScript wire contract between the JS reducer bundle and the SDK-owned reducer bundle ABI. The JSON Schema in ./schema is authoritative.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./bundle": "./src/bundle.ts",
    "./wire": "./generated/wire.ts",
    "./zod": "./generated/zod.ts",
    "./builders": "./generated/builders.ts",
    "./version": "./generated/version.ts",
    "./schema": "./schema/reducer-runtime.schema.json",
    "./fixtures": "./fixtures/index.ts"
  },
  "files": [
    "LICENSE.md",
    "schema",
    "generated",
    "src",
    "fixtures",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__fixtures__/**",
    "!src/**/*.stories.ts",
    "!src/**/*.stories.tsx",
    "!src/stories/**",
    "!visual/**",
    "!.turbo/**",
    "!tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "generate": "node scripts/generate-ts.mjs",
    "generate:check": "node scripts/generate-check.mjs",
    "build": "pnpm generate && tsc --noEmit",
    "typecheck": "pnpm generate && tsc --noEmit",
    "test": "pnpm generate && bun test",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@dreamboard-games/sdk-types": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "zod": "4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamboard-games/dreamboard-sdk.git",
    "directory": "packages/reducer-contract"
  },
  "bugs": {
    "url": "https://github.com/dreamboard-games/dreamboard-sdk/issues"
  },
  "homepage": "https://github.com/dreamboard-games/dreamboard-sdk#readme",
  "keywords": [
    "dreamboard",
    "sdk",
    "reducer",
    "contract"
  ],
  "license": "SEE LICENSE IN LICENSE.md"
}
