{
  "name": "@dreamboard-games/reducer-contract",
  "version": "0.4.0",
  "private": true,
  "description": "Single-source-of-truth TypeScript wire contract between the JS reducer bundle and the SDK-owned reducer bundle ABI. The JSON Schema in ./schema is authoritative.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./bundle": {
      "types": "./dist/src/bundle.d.ts",
      "import": "./src/bundle.ts",
      "default": "./src/bundle.ts"
    },
    "./wire": {
      "types": "./dist/generated/wire.d.ts",
      "import": "./generated/wire.ts",
      "default": "./generated/wire.ts"
    },
    "./zod": {
      "types": "./dist/generated/zod.d.ts",
      "import": "./generated/zod.ts",
      "default": "./generated/zod.ts"
    },
    "./builders": {
      "types": "./dist/generated/builders.d.ts",
      "import": "./generated/builders.ts",
      "default": "./generated/builders.ts"
    },
    "./version": {
      "types": "./dist/generated/version.d.ts",
      "import": "./generated/version.ts",
      "default": "./generated/version.ts"
    },
    "./schema": "./schema/reducer-runtime.schema.json",
    "./fixtures": "./fixtures/index.ts"
  },
  "files": [
    "LICENSE.md",
    "schema",
    "generated",
    "src",
    "fixtures",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__fixtures__/**",
    "!src/**/*.stories.ts",
    "!src/**/*.stories.tsx",
    "!src/stories/**",
    "!visual/**",
    "!.turbo/**",
    "!tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@dreamboard-games/sdk-types": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": "4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamboard-games/dreamboard-sdk.git",
    "directory": "packages/reducer-contract"
  },
  "bugs": {
    "url": "https://github.com/dreamboard-games/dreamboard-sdk/issues"
  },
  "homepage": "https://github.com/dreamboard-games/dreamboard-sdk#readme",
  "keywords": [
    "dreamboard",
    "sdk",
    "reducer",
    "contract"
  ],
  "license": "SEE LICENSE IN LICENSE.md"
}
