{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../..",
    "allowImportingTsExtensions": true,
    "paths": {
      "@dreamboard-games/sdk": ["./src/index.ts"],
      "@dreamboard-games/sdk/reducer": ["./src/reducer.ts"],
      "@dreamboard-games/sdk/testing": ["./src/testing.ts"],
      "@dreamboard-games/sdk/react": ["./src/react.ts"]
    },
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "bench/**/*.ts",
    "test-support/**/*.ts"
  ],
  "exclude": []
}
