{
  "name": "@dreamboard-games/sdk",
  "version": "0.5.0-alpha.4",
  "description": "Typed headless game instances, reducer authoring, React integration and testing",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./reducer": {
      "types": "./dist/reducer.d.ts",
      "import": "./dist/reducer.js",
      "default": "./dist/reducer.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json",
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "LICENSE.md",
    "dist",
    "README.md",
    "!tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.testing-contract.json",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "test": "vitest run src"
  },
  "dependencies": {
    "@noble/hashes": "catalog:",
    "@tanstack/store": "0.11.1",
    "honeycomb-grid": "4.1.5"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@tanstack/react-store": "0.11.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:",
    "esbuild": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3",
    "@tanstack/react-store": "0.11.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamboard-games/dreamboard-sdk.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/dreamboard-games/dreamboard-sdk/issues"
  },
  "homepage": "https://github.com/dreamboard-games/dreamboard-sdk#readme",
  "keywords": [
    "dreamboard",
    "sdk",
    "package-set"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@tanstack/react-store": {
      "optional": true
    }
  }
}
