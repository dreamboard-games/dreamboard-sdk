{
  "name": "@dreamboard-games/sdk",
  "version": "0.2.1-alpha.1",
  "description": "Dreamboard SDK package set metadata and public facade",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package-set": {
      "bun": "./src/package-set.ts",
      "types": "./dist/package-set.d.ts",
      "import": "./dist/package-set.js",
      "default": "./dist/package-set.js"
    },
    "./types": {
      "bun": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./reducer": {
      "bun": "./src/reducer.ts",
      "types": "./dist/reducer.d.ts",
      "import": "./dist/reducer.js",
      "default": "./dist/reducer.js"
    },
    "./ui": {
      "bun": "./src/ui.ts",
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "default": "./dist/ui.js"
    },
    "./ui/components": {
      "bun": "./src/ui/components.ts",
      "types": "./dist/ui/components.d.ts",
      "import": "./dist/ui/components.js",
      "default": "./dist/ui/components.js"
    },
    "./ui/defaults": {
      "bun": "./src/ui/defaults.ts",
      "types": "./dist/ui/defaults.d.ts",
      "import": "./dist/ui/defaults.js",
      "default": "./dist/ui/defaults.js"
    },
    "./ui/types/player-state": {
      "bun": "./src/ui/types/player-state.ts",
      "types": "./dist/ui/types/player-state.d.ts",
      "import": "./dist/ui/types/player-state.js",
      "default": "./dist/ui/types/player-state.js"
    },
    "./ui/plugin-styles.css": {
      "default": "./dist/ui/plugin-styles.css"
    },
    "./runtime": {
      "bun": "./src/runtime.ts",
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./runtime/primitives": {
      "bun": "./src/runtime/primitives.ts",
      "types": "./dist/runtime/primitives.d.ts",
      "import": "./dist/runtime/primitives.js",
      "default": "./dist/runtime/primitives.js"
    },
    "./runtime/workspace-contract": {
      "bun": "./src/runtime/workspace-contract.ts",
      "types": "./dist/runtime/workspace-contract.d.ts",
      "import": "./dist/runtime/workspace-contract.js",
      "default": "./dist/runtime/workspace-contract.js"
    },
    "./runtime/types/runtime-api": {
      "bun": "./src/runtime/types/runtime-api.ts",
      "types": "./dist/runtime/types/runtime-api.d.ts",
      "import": "./dist/runtime/types/runtime-api.js",
      "default": "./dist/runtime/types/runtime-api.js"
    },
    "./generated/runtime": {
      "bun": "./src/generated/runtime.ts",
      "types": "./dist/generated/runtime.d.ts",
      "import": "./dist/generated/runtime.js",
      "default": "./dist/generated/runtime.js"
    },
    "./generated/runtime-api": {
      "bun": "./src/generated/runtime-api.ts",
      "types": "./dist/generated/runtime-api.d.ts",
      "import": "./dist/generated/runtime-api.js",
      "default": "./dist/generated/runtime-api.js"
    },
    "./generated/runtime/primitives": {
      "bun": "./src/generated/runtime/primitives.ts",
      "types": "./dist/generated/runtime/primitives.d.ts",
      "import": "./dist/generated/runtime/primitives.js",
      "default": "./dist/generated/runtime/primitives.js"
    },
    "./generated/workspace-contract": {
      "bun": "./src/generated/workspace-contract.ts",
      "types": "./dist/generated/workspace-contract.d.ts",
      "import": "./dist/generated/workspace-contract.js",
      "default": "./dist/generated/workspace-contract.js"
    },
    "./infrastructure/reducer-bundle-abi": {
      "bun": "./src/infrastructure/reducer-bundle-abi.ts",
      "types": "./dist/infrastructure/reducer-bundle-abi.d.ts",
      "import": "./dist/infrastructure/reducer-bundle-abi.js",
      "default": "./dist/infrastructure/reducer-bundle-abi.js"
    },
    "./infrastructure/workspace-codegen": {
      "bun": "./src/infrastructure/workspace-codegen.ts",
      "types": "./dist/infrastructure/workspace-codegen.d.ts",
      "import": "./dist/infrastructure/workspace-codegen.js",
      "default": "./dist/infrastructure/workspace-codegen.js"
    },
    "./testing": {
      "bun": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./browser-interaction": {
      "bun": "./src/browser-interaction.ts",
      "types": "./dist/browser-interaction.d.ts",
      "import": "./dist/browser-interaction.js",
      "default": "./dist/browser-interaction.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE.md",
    "dist",
    "src",
    "README.md",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__fixtures__/**",
    "!src/**/*.stories.ts",
    "!src/**/*.stories.tsx",
    "!src/stories/**",
    "!visual/**",
    "!.turbo/**",
    "!tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsup && mkdir -p dist/ui && cp src/ui/plugin-styles.css dist/ui/plugin-styles.css",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts'",
    "test": "bun test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@use-gesture/react": "^10.3.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.5",
    "vaul": "^1.1.2",
    "zod": "4.4.3",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "framer-motion": "^11.0.0 || ^12.0.0",
    "react": "^19.0.0",
    "zod": "4.4.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamboard-games/dreamboard-sdk.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/dreamboard-games/dreamboard-sdk/issues"
  },
  "homepage": "https://github.com/dreamboard-games/dreamboard-sdk#readme",
  "keywords": [
    "dreamboard",
    "sdk",
    "package-set"
  ],
  "license": "SEE LICENSE IN LICENSE.md"
}
