{
  "name": "@dreamboard-games/ui-runtime",
  "version": "0.2.0",
  "private": true,
  "description": "Dreamboard-aware React runtime adapters for generated UI contracts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "dreamboard-source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./reducer": {
      "types": "./dist/reducer.d.ts",
      "dreamboard-source": "./src/reducer.ts",
      "import": "./dist/reducer.js",
      "default": "./dist/reducer.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "dreamboard-source": "./src/primitives/index.ts",
      "import": "./dist/primitives/index.js",
      "default": "./dist/primitives/index.js"
    },
    "./workspace-contract": {
      "types": "./dist/workspace-contract.d.ts",
      "dreamboard-source": "./src/workspace-contract.ts",
      "import": "./dist/workspace-contract.js",
      "default": "./dist/workspace-contract.js"
    },
    "./types/runtime-api": {
      "types": "./dist/types/runtime-api.d.ts",
      "dreamboard-source": "./src/types/runtime-api.ts",
      "import": "./dist/types/runtime-api.js",
      "default": "./dist/types/runtime-api.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE.md",
    "dist",
    "src",
    "type-stubs",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__fixtures__/**",
    "!src/**/*.stories.ts",
    "!src/**/*.stories.tsx",
    "!src/stories/**",
    "!visual/**",
    "!.turbo/**",
    "!tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -b && rollup -c rollup.config.js",
    "postbuild": "echo 'Generated ui-runtime.d.ts'",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "bun test",
    "test:unit": "bun test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dreamboard-games/sdk-types": "workspace:*",
    "@dreamboard-games/ui-sdk": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@use-gesture/react": "^10.3.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "tailwindcss": "^4.1.5",
    "vaul": "^1.1.2",
    "zod": "4.4.3",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.34.0",
    "react-dom": "^19.2.0",
    "rollup": "^4.28.1",
    "rollup-plugin-dts": "^6.1.1",
    "typescript": "5.7.3"
  },
  "peerDependencies": {
    "framer-motion": "^11.0.0",
    "react": "^19.0.0",
    "zod": "4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamboard-games/dreamboard-sdk.git",
    "directory": "packages/ui-runtime"
  },
  "bugs": {
    "url": "https://github.com/dreamboard-games/dreamboard-sdk/issues"
  },
  "homepage": "https://github.com/dreamboard-games/dreamboard-sdk#readme",
  "keywords": [
    "dreamboard",
    "sdk",
    "react",
    "runtime"
  ],
  "license": "SEE LICENSE IN LICENSE.md"
}
