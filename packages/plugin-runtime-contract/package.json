{
  "name": "@dreamboard-games/plugin-runtime-contract",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-free plugin runtime frame, protocol, schema, and digest contract for Dreamboard game plugins.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./digest": {
      "types": "./dist/digest.d.ts",
      "import": "./dist/digest.js",
      "default": "./dist/digest.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "bun test src"
  },
  "files": [
    "LICENSE.md",
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!tsconfig.tsbuildinfo"
  ],
  "dependencies": {
    "@noble/hashes": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "zod": "4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamboard-games/dreamboard-sdk.git",
    "directory": "packages/plugin-runtime-contract"
  },
  "bugs": {
    "url": "https://github.com/dreamboard-games/dreamboard-sdk/issues"
  },
  "homepage": "https://github.com/dreamboard-games/dreamboard-sdk#readme",
  "keywords": [
    "dreamboard",
    "sdk",
    "plugin",
    "runtime",
    "contract"
  ],
  "license": "SEE LICENSE IN LICENSE.md"
}
