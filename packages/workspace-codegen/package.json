{
  "name": "@dreamboard-games/workspace-codegen",
  "version": "0.2.0",
  "description": "Internal Dreamboard workspace source generator",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "lint": "eslint 'src/**/*.ts'",
    "test": "bun test --timeout 30000",
    "test:unit": "bun test --timeout 30000"
  },
  "dependencies": {
    "@dreamboard-games/sdk-types": "workspace:*",
    "@dreamboard-games/ui-runtime": "workspace:*",
    "@dreamboard-games/ui-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "eslint": "^9.39.0",
    "typescript": "5.7.3",
    "zod": "4.4.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE.md",
    "dist",
    "src",
    "ownership.json",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__fixtures__/**",
    "!src/**/*.stories.ts",
    "!src/**/*.stories.tsx",
    "!src/stories/**",
    "!visual/**",
    "!.turbo/**",
    "!tsconfig.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamboard-games/dreamboard-sdk.git",
    "directory": "packages/workspace-codegen"
  },
  "bugs": {
    "url": "https://github.com/dreamboard-games/dreamboard-sdk/issues"
  },
  "homepage": "https://github.com/dreamboard-games/dreamboard-sdk#readme",
  "keywords": [
    "dreamboard",
    "sdk",
    "codegen",
    "workspace"
  ],
  "license": "SEE LICENSE IN LICENSE.md"
}
