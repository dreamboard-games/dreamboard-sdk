{
  "name": "@dreamboard-games/app-sdk",
  "version": "0.2.0",
  "private": true,
  "description": "App authoring SDK for Dreamboard game logic",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./reducer": {
      "bun": "./src/reducer.ts",
      "types": "./dist/reducer.d.ts",
      "import": "./dist/reducer.js",
      "default": "./dist/reducer.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE.md",
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__fixtures__/**",
    "!src/**/*.stories.ts",
    "!src/**/*.stories.tsx",
    "!src/stories/**",
    "!visual/**",
    "!.turbo/**",
    "!tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/fix-dist-imports.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.type-tests.json",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "test": "bun test",
    "test:unit": "bun test"
  },
  "dependencies": {
    "@dreamboard-games/reducer-contract": "workspace:*",
    "@dreamboard-games/sdk-types": "workspace:*"
  },
  "devDependencies": {
    "@dreamboard-games/workspace-codegen": "workspace:*",
    "@types/bun": "latest",
    "@types/node": "^24.3.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "zod": "4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamboard-games/dreamboard-sdk.git",
    "directory": "packages/app-sdk"
  },
  "bugs": {
    "url": "https://github.com/dreamboard-games/dreamboard-sdk/issues"
  },
  "homepage": "https://github.com/dreamboard-games/dreamboard-sdk#readme",
  "keywords": [
    "dreamboard",
    "sdk",
    "reducer",
    "authoring"
  ],
  "license": "SEE LICENSE IN LICENSE.md"
}
