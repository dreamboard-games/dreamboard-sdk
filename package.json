{
  "name": "dreamboard-sdk",
  "private": true,
  "version": "0.4.0-alpha.11",
  "description": "Dreamboard public SDK package-set monorepo",
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build --filter=!@dreamboard-games/ui-workbench",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm generate:check && pnpm publication:check && pnpm version:check && pnpm peer-hygiene:check && pnpm reference-games:source-size:check && pnpm build && pnpm exports:check && pnpm docs:check && pnpm test",
    "authoring-metadata:generate": "node scripts/generate-authoring-metadata.mjs",
    "authoring-metadata:check": "node scripts/generate-authoring-metadata.mjs --check",
    "docs:check": "node scripts/generate-agent-reference.mjs --check",
    "docs:generate": "pnpm ui:catalog:generate && node scripts/generate-agent-reference.mjs && node scripts/ui/generate-ui-agent-docs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "exports:check": "node scripts/assert-sdk-export-parity.mjs",
    "generate:check": "pnpm --filter @dreamboard-games/reducer-contract generate:check && pnpm authoring-metadata:check",
    "lint": "turbo run lint",
    "peer-hygiene:check": "node scripts/assert-peer-hygiene.mjs",
    "publication:check": "node scripts/assert-publication-boundary.mjs",
    "reference-games:source:materialize": "node scripts/reference-games/build-source-bundle.mjs",
    "reference-games:bundle": "pnpm reference-games:source:materialize",
    "reference-games:check": "node scripts/reference-games/check.mjs",
    "reference-games:repin": "node scripts/reference-games/repin-sdk.ts",
    "reference-games:source-size:check": "node scripts/reference-games/source-size-check.mjs",
    "reference-games:source:test": "node --test scripts/reference-games/*.test.mjs",
    "reference-games:test:packed": "node scripts/ui/verify-reference-consumers.mjs",
    "reference-games:verify-publishable": "node scripts/ui/verify-publishable-reference-games.mjs",
    "publish:alpha": "pnpm verify:release && npm publish build/proofs/release/current/candidate/*.tgz --access public --tag alpha",
    "publish:alpha:dry-run": "pnpm verify:release && npm publish build/proofs/release/current/candidate/*.tgz --access public --tag alpha --dry-run",
    "storybook": "pnpm --filter @dreamboard-games/sdk storybook",
    "storybook:build": "pnpm --filter @dreamboard-games/sdk storybook:build",
    "test": "turbo run test --filter=!@dreamboard-games/ui-workbench",
    "typecheck": "turbo run typecheck",
    "ui:storybook": "pnpm --filter @dreamboard-games/sdk storybook",
    "ui:storybook:build": "pnpm --filter @dreamboard-games/sdk storybook:build",
    "ui:test:stories": "node scripts/ui/run-story-tests.mjs",
    "ui:test:visual": "node scripts/ui/run-visual-tests.mjs",
    "ui:coverage:check": "node scripts/ui/assert-component-coverage.mjs",
    "ui:fixtures:compile": "pnpm ui:workbench:materialize",
    "ui:fixtures:check": "pnpm ui:workbench:materialize",
    "ui:workbench": "pnpm --filter @dreamboard-games/sdk build && node scripts/ui/open-ui-workbench.mjs",
    "ui:workbench:src": "pnpm --filter @dreamboard-games/sdk build && DREAMBOARD_WORKBENCH_SDK=source node scripts/ui/open-ui-workbench.mjs",
    "ui:workbench:dev": "pnpm --filter @dreamboard-games/sdk build && node scripts/ui/run-workbench-command.mjs dev",
    "ui:workbench:build": "pnpm --filter @dreamboard-games/sdk build && node scripts/ui/run-workbench-command.mjs build",
    "ui:workbench:materialize": "pnpm --filter @dreamboard-games/sdk build && node scripts/ui/materialize-workbench.mjs",
    "ui:workbench:reuse": "pnpm --filter @dreamboard-games/sdk build && node scripts/ui/materialize-workbench.mjs --reuse-existing",
    "ui:catalog:generate": "pnpm ui:workbench:materialize && node scripts/ui/generate-scenario-catalog.mjs",
    "ui:catalog:check": "pnpm ui:workbench:materialize && node scripts/ui/generate-scenario-catalog.mjs --check",
    "ui:test": "pnpm --filter @dreamboard-games/sdk build && node scripts/ui/run-ui-scenarios.mjs",
    "ui:test:changed": "pnpm --filter @dreamboard-games/sdk build && node scripts/ui/run-ui-scenarios.mjs --changed",
    "ui:test:packed": "node scripts/ui/run-packed-ui-scenarios.mjs",
    "ui:test:parity": "pnpm --filter @dreamboard-games/sdk build && node scripts/ui/run-ui-parity.mjs",
    "ui:hard-cut:check": "node --test scripts/ui/workbench-materialization-guard.test.mjs scripts/ui/materialize-workspace-bootstrap.test.mjs scripts/ui-fixtures/reference-scenario-hard-cut.test.mjs && node scripts/ui/check-ui-hard-cut.mjs",
    "ui:runtime:test": "pnpm --filter @dreamboard-games/sdk build && pnpm --filter @dreamboard-games/sdk test src/testing/ui-fixture && pnpm --filter @dreamboard-games/ui-workbench typecheck && pnpm --filter @dreamboard-games/ui-workbench test:runtime",
    "ui:check:baseline": "pnpm ui:workbench:reuse && pnpm ui:coverage:check && node scripts/ui/generate-scenario-catalog.mjs --check && node scripts/ui-fixtures/check-fixtures.mjs && pnpm ui:test:stories && pnpm ui:test:visual",
    "ui:check": "pnpm ui:hard-cut:check && pnpm ui:check:baseline && node scripts/ui/generate-ui-agent-docs.mjs --check && pnpm ui:test --required --reuse-materialization",
    "ui:release-proof": "node scripts/ui/create-ui-release-proof.mjs",
    "verify:package": "pnpm build && node scripts/pack-and-smoke-sdk.mjs --skip-build --out build/proofs/package/current",
    "verify:ui": "pnpm build && pnpm ui:check",
    "verify:release": "node scripts/verify-sdk-release.mjs --out build/proofs/release/current",
    "version:check": "node scripts/assert-fixed-version.mjs"
  },
  "devDependencies": {
    "@dreamboard-games/cli": "0.1.30-alpha.45",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.5.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.6.2",
    "tsx": "^4.23.0",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamboard-games/dreamboard-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/dreamboard-games/dreamboard-sdk/issues"
  },
  "homepage": "https://github.com/dreamboard-games/dreamboard-sdk#readme",
  "keywords": [
    "dreamboard",
    "sdk",
    "games",
    "monorepo"
  ],
  "license": "SEE LICENSE IN LICENSE.md"
}
