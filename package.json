{
  "name": "dreamboard-sdk",
  "private": true,
  "version": "0.4.0-alpha.4",
  "description": "Dreamboard public SDK package-set monorepo",
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm generate:check && pnpm publication:check && pnpm version:check && pnpm peer-hygiene:check && pnpm build && pnpm exports:check && pnpm pack:consumer-check && pnpm docs:check && pnpm test && pnpm pack:dry-run",
    "authoring-metadata:generate": "node scripts/generate-authoring-metadata.mjs",
    "authoring-metadata:check": "node scripts/generate-authoring-metadata.mjs --check",
    "authoring:candidate": "node scripts/build-authoring-candidate.mjs",
    "docs:check": "node scripts/generate-agent-reference.mjs --check",
    "docs:generate": "node scripts/generate-agent-reference.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "exports:check": "node scripts/assert-sdk-export-parity.mjs",
    "generate:check": "pnpm --filter @dreamboard-games/reducer-contract generate:check && pnpm authoring-metadata:check",
    "lint": "turbo run lint",
    "local-registry:publish": "node scripts/publish-local-snapshot.mjs",
    "pack:dry-run": "node scripts/pack-dry-run.mjs",
    "pack:consumer-check": "node scripts/pack-and-smoke-sdk.mjs",
    "peer-hygiene:check": "node scripts/assert-peer-hygiene.mjs",
    "publication:check": "node scripts/assert-publication-boundary.mjs",
    "reference-games:bundle": "node scripts/ui/build-reference-bundle.mjs",
    "reference-games:check": "node scripts/ui/check-reference-games.mjs",
    "reference-games:test:packed": "node scripts/ui/verify-reference-consumers.mjs",
    "publish:alpha": "pnpm check && cd packages/sdk && npm publish --access public --tag alpha",
    "publish:alpha:dry-run": "pnpm check && cd packages/sdk && npm publish --access public --tag alpha --dry-run",
    "storybook": "pnpm --filter @dreamboard-games/sdk storybook",
    "storybook:build": "pnpm --filter @dreamboard-games/sdk storybook:build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "ui:storybook": "pnpm --filter @dreamboard-games/sdk storybook",
    "ui:storybook:build": "pnpm --filter @dreamboard-games/sdk storybook:build",
    "ui:test:stories": "pnpm ui:storybook:build && pnpm --filter @dreamboard-games/sdk storybook:test",
    "ui:test:visual": "pnpm ui:storybook:build && pnpm --filter @dreamboard-games/sdk storybook:test:visual",
    "ui:coverage:check": "node scripts/ui/assert-component-coverage.mjs",
    "ui:fixtures:compile": "pnpm --filter @dreamboard-games/sdk build && node scripts/ui-fixtures/compile-reference-fixtures.mjs",
    "ui:fixtures:check": "pnpm --filter @dreamboard-games/sdk build && node scripts/ui-fixtures/check-fixtures.mjs",
    "ui:workbench": "node scripts/ui/open-ui-workbench.mjs",
    "ui:workbench:dev": "pnpm --filter @dreamboard-games/ui-workbench dev",
    "ui:workbench:build": "pnpm --filter @dreamboard-games/ui-workbench build",
    "ui:catalog:generate": "node scripts/ui/generate-scenario-catalog.mjs",
    "ui:catalog:check": "node scripts/ui/generate-scenario-catalog.mjs --check",
    "ui:test": "node scripts/ui/run-ui-scenarios.mjs",
    "ui:test:changed": "node scripts/ui/run-ui-scenarios.mjs --changed",
    "ui:test:packed": "node scripts/ui/verify-reference-consumers.mjs",
    "ui:test:parity": "pnpm --filter @dreamboard-games/sdk build && node scripts/ui/run-ui-parity.mjs",
    "ui:ergonomics:check": "node scripts/ui/check-reference-ui-ergonomics.mjs",
    "ui:runtime:test": "pnpm --filter @dreamboard-games/sdk build && pnpm --filter @dreamboard-games/sdk test src/testing/ui-fixture && pnpm --filter @dreamboard-games/ui-workbench typecheck && pnpm --filter @dreamboard-games/ui-workbench test:runtime",
    "ui:check:baseline": "pnpm ui:coverage:check && pnpm ui:test:stories && pnpm ui:test:visual",
    "ui:check": "pnpm ui:fixtures:check && pnpm ui:runtime:test && pnpm ui:check:baseline",
    "version:check": "node scripts/assert-fixed-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.5.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.6.2",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamboard-games/dreamboard-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/dreamboard-games/dreamboard-sdk/issues"
  },
  "homepage": "https://github.com/dreamboard-games/dreamboard-sdk#readme",
  "keywords": [
    "dreamboard",
    "sdk",
    "games",
    "monorepo"
  ],
  "license": "SEE LICENSE IN LICENSE.md"
}
