{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "scripts/copy-sdk-private-dts.mjs",
    "scripts/generate-authoring-metadata.mjs"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "generated/**", "build/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
