{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@game": ["./typecheck/game.ts"]
    }
  },
  "include": [
    "items/**/*.tsx",
    "stories/**/*.tsx",
    "scripts/**/*.ts",
    ".storybook/**/*.ts",
    "items/**/*.ts"
  ]
}
