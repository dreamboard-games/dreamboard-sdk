{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "dreamboard",
  "homepage": "https://dreamboard.games",
  "items": [
    {
      "$schema": "https://ui.shadcn.com/schema/registry-item.json",
      "name": "tokens",
      "type": "registry:style",
      "title": "Tokens",
      "description": "Dreamboard visual tokens and component styles.",
      "files": [
        {
          "path": "items/tokens.css",
          "type": "registry:file",
          "target": "@components/dreamboard/tokens.css"
        }
      ]
    },
    {
      "$schema": "https://ui.shadcn.com/schema/registry-item.json",
      "name": "card",
      "type": "registry:component",
      "title": "Card",
      "description": "Pure, composable card presentation. No SDK dependency.",
      "files": [
        {
          "path": "items/card.tsx",
          "type": "registry:component",
          "target": "@components/dreamboard/card.tsx"
        }
      ],
      "registryDependencies": ["@dreamboard/tokens"]
    },
    {
      "$schema": "https://ui.shadcn.com/schema/registry-item.json",
      "name": "playing-card",
      "type": "registry:component",
      "title": "Playing Card",
      "description": "Pure, composable playing card presentation. No SDK dependency.",
      "files": [
        {
          "path": "items/playing-card.tsx",
          "type": "registry:component",
          "target": "@components/dreamboard/playing-card.tsx"
        }
      ],
      "registryDependencies": ["@dreamboard/tokens", "@dreamboard/card"]
    },
    {
      "$schema": "https://ui.shadcn.com/schema/registry-item.json",
      "name": "pile",
      "type": "registry:component",
