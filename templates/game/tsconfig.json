{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@game": ["./ui/game.tsx"],
      "@/*": ["./ui/*"]
    },
    "types": ["vite/client"]
  },
  "include": [
    "manifest.ts",
    "app/**/*.ts",
    "test/**/*.ts",
    "ui/**/*.ts",
    "ui/**/*.tsx",
    "vite.config.ts"
  ]
}
