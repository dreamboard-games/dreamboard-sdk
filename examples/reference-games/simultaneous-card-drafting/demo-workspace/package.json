{
  "name": "@dreamboard/example-simultaneous-card-drafting",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dreamboard dev",
    "typecheck": "tsc --noEmit -p manifest.tsconfig.json && tsc --noEmit -p app/tsconfig.json && tsc --noEmit -p ui/tsconfig.json",
    "typecheck:manifest": "tsc --noEmit -p manifest.tsconfig.json",
    "typecheck:app": "tsc --noEmit -p app/tsconfig.json",
    "typecheck:ui": "tsc --noEmit -p ui/tsconfig.json",
    "test:ui": "tsx --tsconfig test/tsconfig.tsx-runtime.json --test test/ui/*.test.tsx"
  },
  "dependencies": {
    "@dreamboard-games/sdk": "0.4.0-alpha.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "csstype": "^3.2.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.6",
      "react-dom": "19.2.6",
      "zod": "4.4.3"
    }
  },
  "packageManager": "pnpm@10.4.1"
}
