{
  "scenarioId": "roll-and-write-scorecard.mark-cell.mobile",
  "mechanics": [
    "roll-and-write",
    "square-grid",
    "dice-result",
    "simultaneous-marking"
  ],
  "uiPatterns": [
    "square-board-targets",
    "scorecard-grid",
    "drafted-mark",
    "compact-mobile-scorecard"
  ],
  "assertions": [
    "initial state starts before the first seeded roll",
    "deterministic dice result highlights legal scorecard cells",
    "eligible cells use the existing board-space browser effect",
    "drafted mark remains pending until submit",
    "submitted mark advances seat-order resolution",
    "ineligible cells remain visible but unselectable",
    "stale and illegal submissions are rejected by reducer validation",
    "failed survey fallback remains reducer-owned when no matching square remains",
    "seat-order resolution preserves the shared roll for every player",
    "complete game scores rows columns largest region and failed surveys",
    "mobile scorecard preserves compact square-grid targeting"
  ],
  "scenarios": {
    "initial": {
      "id": "roll-and-write-scorecard.initial",
      "phase": "roll",
      "round": 1,
      "playerIds": ["player-1", "player-2"],
      "roll": null,
      "expected": "no scorecard marks exist before the first automatic roll"
    },
    "dice": {
      "id": "roll-and-write-scorecard.dice",
      "phase": "markSurvey",
      "round": 1,
      "dice": [2, 3],
      "total": 5,
      "activePlayerId": "player-1",
      "eligibleSpaceIds": ["cell-0-1", "cell-3-2"]
    },
    "draft": {
      "id": "roll-and-write-scorecard.draft",
      "inputKey": "cell",
      "spaceId": "cell-0-1",
      "draft": {
        "kind": "survey-mark",
        "playerId": "player-1",
        "round": 1,
        "rollTotal": 5
      },
      "expected": "draft exists but player marks remain unchanged until submit"
    },
    "submitted": {
      "id": "roll-and-write-scorecard.submitted",
      "inputKey": "cell",
      "spaceId": "cell-0-1",
      "accepted": true,
      "mark": {
        "kind": "surveyed",
        "round": 1,
        "rolledTotal": 5
      },
      "nextActivePlayerId": "player-2"
    },
    "invalid": {
      "id": "roll-and-write-scorecard.invalid",
      "inputKey": "cell",
      "spaceId": "cell-1-0",
      "accepted": false,
      "errorCode": "CELL_DOES_NOT_MATCH_ROLL",
      "staleErrorCode": "STALE_SUBMISSION"
    },
    "complete": {
      "id": "roll-and-write-scorecard.complete",
      "rounds": 8,
      "completed": true,
      "scoreComponents": [
        "completeRows",
        "completeColumns",
        "largestRegion",
        "failedSurveys"
      ]
    }
  },
  "replay": {
    "kind": "board-space",
    "inputKey": "cell",
    "spaceId": "cell-0-1",
    "eligibleSpaceIds": ["cell-0-1", "cell-3-2"]
  }
}
