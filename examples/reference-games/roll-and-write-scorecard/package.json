{
  "name": "@dreamboard/example-cloudline-survey",
  "private": true,
  "type": "module",
  "imports": {
    "#dreamboard/ui-contract": "./shared/generated/ui-contract.ts"
  },
  "scripts": {
    "dev": "dreamboard dev",
    "typecheck": "tsc --noEmit -p manifest.tsconfig.json && tsc --noEmit -p app/tsconfig.json && tsc --noEmit -p ui/tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "typecheck:manifest": "tsc --noEmit -p manifest.tsconfig.json",
    "typecheck:app": "tsc --noEmit -p app/tsconfig.json",
    "typecheck:ui": "tsc --noEmit -p ui/tsconfig.json",
    "typecheck:test": "tsc --noEmit -p test/tsconfig.json",
    "test": "tsx --test test/scenarios/*.scenario.ts test/ui-scenarios/*.scenario.ts",
    "test:ui": "tsx --tsconfig test/tsconfig.json --test test/ui-scenarios/*.scenario.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm test:ui"
  },
  "dependencies": {
    "@dreamboard-games/sdk": "0.4.0-alpha.6",
    "framer-motion": "12.38.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.12",
    "@types/node": "^24.5.2",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "csstype": "^3.1.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "use-sync-external-store": "1.6.0"
  },
  "packageManager": "pnpm@10.4.1",
  "pnpm": {
    "overrides": {
      "zod": "4.4.3",
      "react": "19.2.6",
      "react-dom": "19.2.6",
      "@types/react": "19.2.16",
      "@types/react-dom": "19.2.3",
      "framer-motion": "12.38.0",
      "use-sync-external-store": "1.6.0"
    }
  }
}
