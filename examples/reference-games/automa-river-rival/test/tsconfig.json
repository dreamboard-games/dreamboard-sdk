{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../app/**/*.ts",
    "../shared/**/*.ts",
    "../ui/**/*.ts",
    "../ui/**/*.tsx"
  ],
  "exclude": ["./generated/**"]
}
