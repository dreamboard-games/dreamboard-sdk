{
  "name": "@dreamboard-reference/worker-placement-tableau",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#dreamboard/ui-contract": "./shared/generated/ui-contract.ts"
  },
  "scripts": {
    "dev": "dreamboard dev",
    "typecheck": "tsc --noEmit -p manifest.tsconfig.json && tsc --noEmit -p app/tsconfig.json && tsc --noEmit -p ui/tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "typecheck:manifest": "tsc --noEmit -p manifest.tsconfig.json",
    "typecheck:app": "tsc --noEmit -p app/tsconfig.json",
    "typecheck:ui": "tsc --noEmit -p ui/tsconfig.json",
    "typecheck:test": "tsc --noEmit -p test/tsconfig.json",
    "test": "tsx --tsconfig test/tsconfig.json --test test/scenarios/*.scenario.ts",
    "test:ui": "tsx --tsconfig test/tsconfig.tsx-runtime.json --test test/ui/**/*.test.tsx test/ui-scenarios/**/*.scenario.ts",
    "test:scenarios": "tsx --tsconfig test/tsconfig.json --test test/scenarios/*.scenario.ts",
    "test:scenarios:generate": "dreamboard test generate",
    "verify": "pnpm typecheck && pnpm test && pnpm test:ui"
  },
  "dependencies": {
    "@dreamboard-games/sdk": "0.4.0-alpha.6",
    "lucide-react": "^0.562.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/bun": "1.3.12",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "csstype": "^3.2.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.4.1",
  "pnpm": {
    "overrides": {
      "react": "19.2.6",
      "react-dom": "19.2.6",
      "zod": "4.4.3"
    }
  }
}
