{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./ui/*"],
      "@game": ["./ui/game.ts"]
    }
  },
  "include": [
    "manifest.ts",
    "manifest/**/*.ts",
    "app/**/*.ts",
    "ui/**/*.ts",
    "ui/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "vite.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules"]
}
