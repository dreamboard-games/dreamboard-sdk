{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamboard.games/schemas/competition-game-authoring-brief.schema.json",
  "title": "Competition Game Authoring Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "source",
    "players",
    "authorJobs",
    "uiJobs",
    "authorityJobs",
    "acceptance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 8
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rights"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["original", "anonymized"]
        },
        "rights": {
          "type": "string",
          "enum": ["public-safe-original", "public-safe-anonymized"]
        }
      }
    },
    "players": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "authorJobs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "uiJobs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "authorityJobs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "notes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "formatNotes": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "compactMobile": {
          "type": "boolean"
        },
        "optionalPhysicalNotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
