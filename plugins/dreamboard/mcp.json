{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "dreamboard": {
      "type": "streamable-http",
      "url": "https://api.dreamboard.games/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["dreamboard"]
          }
        }
      }
    }
  }
}
