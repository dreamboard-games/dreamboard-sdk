{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "dreamboard",
  "version": "0.1.4",
  "description": "Find synced Dreamboard projects, edit card data, and customise game code.",
  "author": { "name": "Dreamboard Games" },
  "homepage": "https://dreamboard.games",
  "repository": "https://github.com/dreamboard-games/dreamboard-sdk",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Dreamboard",
        "shortDescription": "Edit synced board games",
        "longDescription": "Use Dreamboard Studio to find your synced game projects, preview and edit saved cards, and customise game code. Device-only projects are available in Studio.",
        "developerName": "Dreamboard Games",
        "category": "Productivity",
        "capabilities": ["Read", "Write"],
        "websiteURL": "https://dreamboard.games",
        "supportURL": "https://dreamboard.games/paid-services#paid-support",
        "privacyPolicyURL": "https://dreamboard.games/privacy",
        "termsOfServiceURL": "https://dreamboard.games/terms",
        "logo": "./assets/icon.png",
        "composerIcon": "./assets/icon.png"
      }
    }
  }
}
